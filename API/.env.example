# Banco (dev: SQLite). Para Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/artix
DATABASE_URL=sqlite:///./artix.db

# Token de admin simples (header X-Admin-Token). Trocar em produção.
ADMIN_TOKEN=changeme-admin

# Chave HMAC opcional para handshake do plugin (fase futura)
PLUGIN_HMAC_SECRET=changeme-plugin
